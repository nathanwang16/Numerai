# Numerai API credentials. Copy to `.env` (or `credentials.txt`) and fill in.
# Both `.env` and `credentials.txt` are gitignored. NEVER commit real keys.
#
# Generate a key pair at: https://numer.ai/account/custom-api-keys
# Recommended scopes for the full pipeline:
#   - View user info, Upload submissions, Upload pickles, Upload diagnostics,
#     Manage models, Stake actions (only if you intend to rebalance stakes).

NUMERAI_PUBLIC_ID=your_public_id_here
NUMERAI_SECRET_KEY=your_secret_key_here
